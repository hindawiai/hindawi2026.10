%{
/* manipuri_beng h2b.uhin: generated from the manipuri_beng lexicon by lang/hindawi/tools/complete_cells.py,
   in the form of Chintamani's own transducers. Constructs without a word are in STATUS.tsv. */
%}
%%
\'("\\\'"|.*)*\'                       {printf("%s",yytext);}
\"("\\\""|[^\"^\n]*)*\"                {printf("%s",yytext);}

কালযন্ত্র                   {printf("TIMER");}
পূর্ণাঙ্ক                   {printf("INT");}
প্রত্যাগম                   {printf("RETURN");}
সহভাজিত                     {printf("SHARED");}
অন্যথা                      {printf("ELSE");}
আহ্঵ান                      {printf("CALL");}
পদা঵লী                      {printf("STRING");}
অস্তু                       {printf("LET");}
ধ্রু঵                       {printf("CONST");}
প্রতি                       {printf("FOR");}
যা঵ত্                       {printf("WHILE");}
স্থির                       {printf("STATIC");}
অন্ত                        {printf("END");}
কুরু                        {printf("DO");}
গচ্ছ                        {printf("GOTO");}
যদি                         {printf("IF");}
ই঵                          {printf("AS");}
চ                           {printf("AND");}
ন                           {printf("NOT");}

%%
