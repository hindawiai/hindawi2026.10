সার্঵জনিক                   {printf("PUBLIC");}
নির্দেশক                    {printf("PTR");}
অন্যথা                      {printf("ELSE");}
আহ্঵ান                      {printf("CALL");}
প্রকার                      {printf("TYPE");}
অন্তঃ                       {printf("IN");}
বাহ্য                       {printf("EXTERN");}
যা঵ত্                       {printf("WHILE");}
অন্ত                        {printf("END");}
এতত্                        {printf("THIS");}
তালক                        {printf("LOCK");}
যদি                         {printf("IF");}
