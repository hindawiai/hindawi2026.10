%{
/* manipuri_beng asm2h.uhin: generated from the manipuri_beng lexicon by lang/hindawi/tools/complete_cells.py,
   in the form of Chintamani's own transducers. Constructs without a word are in STATUS.tsv. */
%}
%%
\'(\\.|[^\\\'\n])*\'                       {printf("%s",yytext);}
\"(\\.|[^\\\"\n])*\"                       {printf("%s",yytext);}

INCLUDE                     {printf("অন্তর্ভা঵");}
ASSUME                      {printf("অধ্য঵স্যতি");}
EXTERN                      {printf("বাহ্য");}
PUBLIC                      {printf("সার্঵জনিক");}
WHILE                       {printf("যা঵ত্");}
CALL                        {printf("আহ্঵ান");}
ELSE                        {printf("অন্যথা");}
LOCK                        {printf("তালক");}
THIS                        {printf("এতত্");}
TYPE                        {printf("প্রকার");}
call                        {printf("আহ্঵ান");}
AND                         {printf("চ");}
END                         {printf("অন্ত");}
INT                         {printf("পূর্ণাঙ্ক");}
NOT                         {printf("ন");}
PTR                         {printf("নির্দেশক");}
IF                          {printf("যদি");}
IN                          {printf("অন্তঃ");}
[A-Za-z_][A-Za-z0-9_]*      {printf("%s",yytext);}
%%
