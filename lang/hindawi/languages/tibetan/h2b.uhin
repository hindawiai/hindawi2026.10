%{
/* tibetan h2b.uhin: generated from the tibetan lexicon by lang/hindawi/tools/complete_cells.py,
   in the form of Chintamani's own transducers. Constructs without a word are in STATUS.tsv. */
%}
%%
\'("\\\'"|.*)*\'                       {printf("%s",yytext);}
\"("\\\""|[^\"^\n]*)*\"                {printf("%s",yytext);}

ཆེད་དུ                      {printf("FOR");}
དེ་མིན                      {printf("ELSE");}
གལ་ཏེ                       {printf("IF");}
ཕྱིར                        {printf("RETURN");}
སྐབས                        {printf("WHILE");}
ཧྲིལ                        {printf("INT");}
ca                          {printf("AND");}
na                          {printf("NOT");}

%%
