%{
/* pashto yacc2h.uhin: generated from the pashto lexicon by lang/hindawi/tools/complete_cells.py,
   in the form of Chintamani's own transducers. Constructs without a word are in STATUS.tsv. */
%}
%%
\'(\\.|[^\\\'\n])*\'                       {printf("%s",yytext);}
\"(\\.|[^\\\"\n])*\"                       {printf("%s",yytext);}

protected                   {printf("محمي");}
\#include                   {printf("#ضمن");}
continue                    {printf("استمر");}
operator                    {printf("چلوونکی");}
register                    {printf("سجل");}
restrict                    {printf("محدود");}
template                    {printf("کينډۍ");}
unsigned                    {printf("بینښه");}
volatile                    {printf("متطاير");}
INT_MAX                     {printf("لوی_عدد");}
default                     {printf("افتراضي");}
isalnum                     {printf("که_توری_یا_عدد");}
isalpha                     {printf("که_توری");}
isdigit                     {printf("که_عدد");}
isspace                     {printf("که_تشه");}
private                     {printf("خاص");}
typedef                     {printf("تعريفنوع");}
virtual                     {printf("افتراضي");}
assert                      {printf("أكد");}
calloc                      {printf("حافظه_صفر_ورکړه");}
double                      {printf("مزدوج");}
extern                      {printf("خارجي");}
friend                      {printf("ملګری");}
inline                      {printf("مضمن");}
malloc                      {printf("حافظه_ورکړه");}
memcpy                      {printf("حافظه_نقل");}
printf                      {printf("چاپ_کړه");}
public                      {printf("عام");}
return                      {printf("أرجع");}
signal                      {printf("إشارة");}
signed                      {printf("نښهدار");}
sizeof                      {printf("حجم");}
static                      {printf("ساكن");}
strlen                      {printf("مزي_اوږدوالی");}
struct                      {printf("بنية");}
switch                      {printf("بدل");}
\#elif                      {printf("#وإلاإذا");}
\#else                      {printf("#وإلا");}
break                       {printf("اكسر");}
const                       {printf("ثابت");}
float                       {printf("عائم");}
raise                       {printf("ارفع");}
right                       {printf("ښی");}
short                       {printf("لنډ");}
union                       {printf("اتحاد");}
while                       {printf("طالما");}
write                       {printf("اكتب");}
NULL                        {printf("عدم");}
auto                        {printf("خپلکاری");}
case                        {printf("حالة");}
char                        {printf("حرف");}
else                        {printf("وإلا");}
enum                        {printf("تعداد");}
free                        {printf("حرر");}
goto                        {printf("اذهب");}
left                        {printf("کیڼ");}
long                        {printf("اوږد");}
main                        {printf("اصلي");}
read                        {printf("اقرأ");}
sqrt                        {printf("جذر");}
type                        {printf("نوع");}
void                        {printf("فراغ");}
\#if                        {printf("#إذا");}
for                         {printf("لكل");}
int                         {printf("صحيح");}
do                          {printf("افعل");}
if                          {printf("إذا");}
[A-Za-z_][A-Za-z0-9_]*      {printf("%s",yytext);}
