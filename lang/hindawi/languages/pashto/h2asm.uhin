%{
/* pashto h2asm.uhin: generated from the pashto lexicon by lang/hindawi/tools/complete_cells.py,
   in the form of Chintamani's own transducers. Constructs without a word are in STATUS.tsv. */
%}
%%
\'("\\\'"|.*)*\'                       {printf("%s",yytext);}
\"("\\\""|[^\"^\n]*)*\"                {printf("%s",yytext);}

إجراء                       {printf("PROC");}
افترض                       {printf("ASSUME");}
خارجي                       {printf("EXTERN");}
طالما                       {printf("WHILE");}
انته                        {printf("END");}
صحيح                        {printf("INT");}
مؤشر                        {printf("PTR");}
نادي                        {printf("CALL");}
وإلا                        {printf("ELSE");}
إذا                         {printf("IF");}
ضمن                         {printf("INCLUDE");}
عام                         {printf("PUBLIC");}
قفل                         {printf("LOCK");}
ليس                         {printf("NOT");}
نوع                         {printf("TYPE");}
هذا                         {printf("THIS");}
أو                          {printf("OR");}
في                          {printf("IN");}
و                           {printf("AND");}

%%
