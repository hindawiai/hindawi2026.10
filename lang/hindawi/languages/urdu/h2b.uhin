%{
/* urdu h2b.uhin: generated from the urdu lexicon by lang/hindawi/tools/complete_cells.py,
   in the form of Chintamani's own transducers. Constructs without a word are in STATUS.tsv. */
%}
%%
\'("\\\'"|.*)*\'                       {printf("%s",yytext);}
\"("\\\""|[^\"^\n]*)*\"                {printf("%s",yytext);}

اختتام                      {printf("END");}
برائے                       {printf("FOR");}
مشترك                       {printf("SHARED");}
بطور                        {printf("AS");}
بلاؤ                        {printf("CALL");}
ثابت                        {printf("CONST");}
جملہ                        {printf("STRING");}
ساکن                        {printf("STATIC");}
صحیح                        {printf("INT");}
مؤقت                        {printf("TIMER");}
مانو                        {printf("LET");}
نہیں                        {printf("NOT");}
واپس                        {printf("RETURN");}
ورنہ                        {printf("ELSE");}
اور                         {printf("AND");}
اگر                         {printf("IF");}
جاؤ                         {printf("GOTO");}
کرو                         {printf("DO");}
جب                          {printf("WHILE");}
یا                          {printf("OR");}

%%
