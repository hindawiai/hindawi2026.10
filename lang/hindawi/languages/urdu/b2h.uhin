%%
\'("\\\'"|.*)*\'                       {printf("%s",yytext);}
\"("\\\""|[^\"^\n]*)*\"                {printf("%s",yytext);}

RETURN                      {printf("واپس");}
SHARED                      {printf("مشترك");}
STATIC                      {printf("ساکن");}
STRING                      {printf("جملہ");}
return                      {printf("واپس");}
CONST                       {printf("ثابت");}
TIMER                       {printf("مؤقت");}
WHILE                       {printf("جب");}
while                       {printf("جب");}
CALL                        {printf("بلاؤ");}
ELSE                        {printf("ورنہ");}
GOTO                        {printf("جاؤ");}
goto                        {printf("جاؤ");}
AND                         {printf("اور");}
END                         {printf("اختتام");}
FOR                         {printf("برائے");}
INT                         {printf("صحیح");}
LET                         {printf("مانو");}
NOT                         {printf("نہیں");}
end                         {printf("اختتام");}
for                         {printf("برائے");}
let                         {printf("مانو");}
AS                          {printf("بطور");}
DO                          {printf("کرو");}
IF                          {printf("اگر");}
OR                          {printf("یا");}
if                          {printf("اگر");}
[A-Za-z_][A-Za-z0-9_]*      {printf("%s",yytext);}
