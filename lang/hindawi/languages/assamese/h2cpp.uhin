%{
/* assamese h2cpp.uhin: generated from the assamese lexicon by lang/hindawi/tools/complete_cells.py,
   in the form of Chintamani's own transducers. Constructs without a word are in STATUS.tsv. */
%}
%%
\'(\\.|[^\\\'\n])*\'                       {printf("%s",yytext);}
\"(\\.|[^\\\"\n])*\"                       {printf("%s",yytext);}

প্রকারনির্দেশ               {printf("typedef");}
\#অন্তর্ভা঵                 {printf("#include");}
\#নোচেদ্যদি                 {printf("#elif");}
পূর্ণাঙ্ক                   {printf("int");}
প্রতিজ্ঞা                   {printf("assert");}
যেতিয়ালৈ                   {printf("while");}
সার্঵জনিক                   {printf("public");}
অন্তঃস্থ                    {printf("inline");}
সুষুপ্তি                    {printf("sleep");}
\#অন্যথা                    {printf("#else");}
অনু঵র্ত                     {printf("continue");}
উত্থাপয                     {printf("raise");}
তার্কিক                     {printf("bool");}
দ্঵িগুণ                     {printf("double");}
নামাকাশ                     {printf("namespace");}
পঞ্জিকা                     {printf("register");}
অন্যথা                      {printf("else");}
পরিমাণ                      {printf("sizeof");}
প্রণাল                      {printf("pipe");}
রক্ষিত                      {printf("protected");}
শ্ৰেণী                      {printf("class");}
সংরচনা                      {printf("struct");}
সঙ্কেত                      {printf("signal");}
স্঵ভা঵                      {printf("default");}
ক্ষিপ                       {printf("throw");}
গুপ্ত                       {printf("private");}
গৃহাণ                       {printf("catch");}
ঘূৰাই                       {printf("return");}
চঞ্চল                       {printf("volatile");}
ধ্রু঵                       {printf("const");}
বাহ্য                       {printf("extern");}
ভিন্ন                       {printf("float");}
মুক্ত                       {printf("free");}
রিক্ত                       {printf("NULL");}
শূন্য                       {printf("void");}
সমকাল                       {printf("sync");}
স্থির                       {printf("static");}
\#যদি                       {printf("#if");}
আভাস                        {printf("virtual");}
এতত্                        {printf("this");}
গচ্ছ                        {printf("goto");}
গণনা                        {printf("enum");}
নূতন                        {printf("new");}
পক্ষ                        {printf("case");}
বাবে                        {printf("for");}
ভঙ্গ                        {printf("break");}
মিছা                        {printf("false");}
যত্ন                        {printf("try");}
সঁচা                        {printf("true");}
সঙ্ঘ                        {printf("union");}
কৰা                         {printf("do");}
যদি                         {printf("if");}
লিখ                         {printf("write");}
পঠ                          {printf("read");}
([A-Za-z0-9_]|[\xC2-\xF4][\x80-\xBF]+)+   {printf("%s",yytext);}
%%
