antata_h                    {printf("finally");}
ca_ncala                    {printf("volatile");}
rak_sita                    {printf("protected");}
su_supti                    {printf("sleep");}
vistr_ta                    {printf("extends");}
bha_nga                     {printf("break");}
གལ་སྲིད                     {printf("if");}
anta_h                      {printf("in");}
k_sipa                      {printf("throw");}
pak_sa                      {printf("case");}
var_na                      {printf("char");}
དེ་མིན                      {printf("else");}
དོན་ལུ                      {printf("for");}
ta_h                        {printf("from");}
སྐབས                        {printf("while");}
ཧྲིལ                        {printf("int");}
ལོག                         {printf("return");}
ca                          {printf("and");}
