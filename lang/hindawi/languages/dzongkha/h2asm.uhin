\'("\\\'"|.*)*\'                       {printf("%s",yytext);}
\"("\\\""|[^\"^\n]*)*\"                {printf("%s",yytext);}

གལ་སྲིད                     {printf("IF");}
anta_h                      {printf("IN");}
དེ་མིན                      {printf("ELSE");}
སྐབས                        {printf("WHILE");}
ཧྲིལ                        {printf("INT");}
ca                          {printf("AND");}
na                          {printf("NOT");}

