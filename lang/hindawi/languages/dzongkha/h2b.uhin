%{
/* dzongkha h2b.uhin: generated from the dzongkha lexicon by lang/hindawi/tools/complete_cells.py,
   in the form of Chintamani's own transducers. Constructs without a word are in STATUS.tsv. */
%}
%%
\'("\\\'"|.*)*\'                       {printf("%s",yytext);}
\"("\\\""|[^\"^\n]*)*\"                {printf("%s",yytext);}

གལ་སྲིད                     {printf("IF");}
དེ་མིན                      {printf("ELSE");}
དོན་ལུ                      {printf("FOR");}
སྐབས                        {printf("WHILE");}
ཧྲིལ                        {printf("INT");}
ལོག                         {printf("RETURN");}
ca                          {printf("AND");}
na                          {printf("NOT");}

%%
