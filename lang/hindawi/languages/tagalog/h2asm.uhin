%{
/* tagalog h2asm.uhin: generated from the tagalog lexicon by lang/hindawi/tools/complete_cells.py,
   in the form of Chintamani's own transducers. Constructs without a word are in STATUS.tsv. */
%}
%%
\'("\\\'"|.*)*\'                       {printf("%s",yytext);}
\"("\\\""|[^\"^\n]*)*\"                {printf("%s",yytext);}

puur_naa_nka                {printf("INT");}
kung_hindi                  {printf("ELSE");}
anta_h                      {printf("IN");}
habang                      {printf("WHILE");}
kung                        {printf("IF");}
ca                          {printf("AND");}
na                          {printf("NOT");}

%%
