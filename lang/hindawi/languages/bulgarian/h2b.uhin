%{
/* bulgarian h2b.uhin: generated from the bulgarian lexicon by lang/hindawi/tools/complete_cells.py,
   in the form of Chintamani's own transducers. Constructs without a word are in STATUS.tsv. */
%}
%%
\'("\\\'"|.*)*\'                       {printf("%s",yytext);}
\"("\\\""|[^\"^\n]*)*\"                {printf("%s",yytext);}

докато                      {printf("WHILE");}
върни                       {printf("RETURN");}
иначе                       {printf("ELSE");}
цяло                        {printf("INT");}
ако                         {printf("IF");}
за                          {printf("FOR");}

%%
