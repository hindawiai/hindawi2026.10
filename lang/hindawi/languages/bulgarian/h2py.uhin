\'("\\\'"|.*)*\'                       {printf("%s",yytext);}
\"("\\\""|[^\"^\n]*)*\"                {printf("%s",yytext);}

докато                      {printf("while");}
върни                       {printf("return");}
иначе                       {printf("else");}
цяло                        {printf("int");}
ако                         {printf("if");}
за                          {printf("for");}

