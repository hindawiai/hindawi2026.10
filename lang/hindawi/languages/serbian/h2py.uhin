%%
\'("\\\'"|.*)*\'                       {printf("%s",yytext);}
\"("\\\""|[^\"^\n]*)*\"                {printf("%s",yytext);}

врати                       {printf("return");}
инако                       {printf("else");}
ако                         {printf("if");}
док                         {printf("while");}
цео                         {printf("int");}
за                          {printf("for");}

%%
