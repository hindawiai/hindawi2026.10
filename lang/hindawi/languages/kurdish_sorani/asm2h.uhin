%{
/* kurdish_sorani asm2h.uhin: generated from the kurdish_sorani lexicon by lang/hindawi/tools/complete_cells.py,
   in the form of Chintamani's own transducers. Constructs without a word are in STATUS.tsv. */
%}
%%
\'("\\\'"|.*)*\'                       {printf("%s",yytext);}
\"("\\\""|[^\"^\n]*)*\"                {printf("%s",yytext);}

INCLUDE                     {printf("ضمن");}
ASSUME                      {printf("افترض");}
EXTERN                      {printf("خارجي");}
PUBLIC                      {printf("عام");}
global                      {printf("عام");}
WHILE                       {printf("طالما");}
CALL                        {printf("نادي");}
ELSE                        {printf("وإلا");}
LOCK                        {printf("قفل");}
PROC                        {printf("إجراء");}
THIS                        {printf("هذا");}
TYPE                        {printf("نوع");}
call                        {printf("نادي");}
AND                         {printf("و");}
END                         {printf("انته");}
INT                         {printf("صحيح");}
NOT                         {printf("ليس");}
PTR                         {printf("مؤشر");}
IF                          {printf("إذا");}
IN                          {printf("في");}
OR                          {printf("أو");}
[A-Za-z_][A-Za-z0-9_]*      {printf("%s",yytext);}
%%
