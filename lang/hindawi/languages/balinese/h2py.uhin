%%
\'("\\\'"|.*)*\'                       {printf("%s",yytext);}
\"("\\\""|[^\"^\n]*)*\"                {printf("%s",yytext);}

puur_naa_nka                {printf("int");}
ni_spaadita                 {printf("implements");}
dviguu_na                   {printf("double");}
gr_haa_na                   {printf("catch");}
antata_h                    {printf("finally");}
ca_ncala                    {printf("volatile");}
rak_sita                    {printf("protected");}
su_supti                    {printf("sleep");}
vistr_ta                    {printf("extends");}
bha_nga                     {printf("break");}
anta_h                      {printf("in");}
k_sipa                      {printf("throw");}
pak_sa                      {printf("case");}
var_na                      {printf("char");}
ᬲᭂᬤᭂᬮ                       {printf("while");}
ta_h                        {printf("from");}
ᬬᬾᬦ᭄                        {printf("if");}
ᬮᬶᬬ                         {printf("else");}
ᬯᬮᬶ                         {printf("return");}
ca                          {printf("and");}
na                          {printf("not");}

