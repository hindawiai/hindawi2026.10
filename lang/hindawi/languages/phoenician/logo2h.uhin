%{
/* phoenician logo2h.uhin: generated from the phoenician lexicon by lang/hindawi/tools/complete_cells.py,
   in the form of Chintamani's own transducers. Constructs without a word are in STATUS.tsv. */
%}
%%
\'("\\\'"|.*)*\'                       {printf("%s",yytext);}
\"("\\\""|[^\"^\n]*)*\"                {printf("%s",yytext);}

forward                     {printf("أمامي");}
end                         {printf("𐤒𐤑");}
if                          {printf("𐤀𐤌");}
[A-Za-z_][A-Za-z0-9_]*      {printf("%s",yytext);}
%%
