%{
/* javanese h2b.uhin: generated from the javanese lexicon by lang/hindawi/tools/complete_cells.py,
   in the form of Chintamani's own transducers. Constructs without a word are in STATUS.tsv. */
%}
%%
\'("\\\'"|.*)*\'                       {printf("%s",yytext);}
\"("\\\""|[^\"^\n]*)*\"                {printf("%s",yytext);}

puur_naa_nka                {printf("INT");}
ꦏꦁꦒꦺꦴ                       {printf("FOR");}
ꦱꦼꦢꦼꦭ                       {printf("WHILE");}
ꦪꦼꦤ꧀                        {printf("IF");}
ꦭꦶꦪ                         {printf("ELSE");}
ꦮꦭꦶ                         {printf("RETURN");}
ca                          {printf("AND");}
na                          {printf("NOT");}

%%
