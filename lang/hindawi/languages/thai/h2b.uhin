%%
\'("\\\'"|.*)*\'                       {printf("%s",yytext);}
\"("\\\""|[^\"^\n]*)*\"                {printf("%s",yytext);}

จำนวนเต็ม                   {printf("INT");}
มิฉะนั้น                    {printf("ELSE");}
สำหรับ                      {printf("FOR");}
ขณะ                         {printf("WHILE");}
คืน                         {printf("RETURN");}
ถ้า                         {printf("IF");}
ca                          {printf("AND");}
na                          {printf("NOT");}

