%{
/* japanese asm2h.uhin: generated from the japanese lexicon by lang/hindawi/tools/complete_cells.py,
   in the form of Chintamani's own transducers. Constructs without a word are in STATUS.tsv. */
%}
%%
\'("\\\'"|.*)*\'                       {printf("%s",yytext);}
\"("\\\""|[^\"^\n]*)*\"                {printf("%s",yytext);}

WHILE                       {printf("ながら");}
ELSE                        {printf("否则");}
INT                         {printf("整数");}
IF                          {printf("もし");}
[A-Za-z_][A-Za-z0-9_]*      {printf("%s",yytext);}
%%
