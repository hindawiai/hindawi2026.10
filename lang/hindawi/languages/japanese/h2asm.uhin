%%
\'("\\\'"|.*)*\'                       {printf("%s",yytext);}
\"("\\\""|[^\"^\n]*)*\"                {printf("%s",yytext);}

ながら                         {printf("WHILE");}
もし                          {printf("IF");}
否则                          {printf("ELSE");}
整数                          {printf("INT");}

