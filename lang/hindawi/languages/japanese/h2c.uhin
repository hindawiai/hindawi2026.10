%%
\'("\\\'"|.*)*\'                       {printf("%s",yytext);}
\"("\\\""|[^\"^\n]*)*\"                {printf("%s",yytext);}

メインページ                      {printf("main");}
\#もし                        {printf("#if");}
\#否则                        {printf("#else");}
ために                         {printf("for");}
ながら                         {printf("while");}
もし                          {printf("if");}
否则                          {printf("else");}
戻る                          {printf("return");}
整数                          {printf("int");}

%%
