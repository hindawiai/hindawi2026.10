%{
/* telugu yacc2h.uhin: generated from the telugu lexicon by lang/hindawi/tools/complete_cells.py,
   in the form of Chintamani's own transducers. Constructs without a word are in STATUS.tsv. */
%}
%%
\'("\\\'"|.*)*\'                       {printf("%s",yytext);}
\"("\\\""|[^\"^\n]*)*\"                {printf("%s",yytext);}

protected                   {printf("రక్షిత");}
\#include                   {printf("#అన్తర్భావ");}
continue                    {printf("కొనసాగు");}
register                    {printf("నమోదు");}
volatile                    {printf("అస్థిర");}
default                     {printf("అప్రమేయ");}
private                     {printf("అంతరంగ");}
typedef                     {printf("రకనిర్వచనం");}
virtual                     {printf("మాయా");}
assert                      {printf("ప్రతిజ్ఞా");}
double                      {printf("ద్విగుణ");}
extern                      {printf("బాహ్య");}
inline                      {printf("అంతఃవరుస");}
public                      {printf("బహిరంగ");}
return                      {printf("తిరిగి");}
signal                      {printf("సంకేతం");}
sizeof                      {printf("పరిమాణం");}
static                      {printf("స్థిర");}
struct                      {printf("నిర్మాణం");}
switch                      {printf("ఎంపిక");}
\#elif                      {printf("#లేదావేళ");}
\#else                      {printf("#లేకపోతే");}
break                       {printf("ఆపు");}
const                       {printf("స్థిరరాశి");}
float                       {printf("దశాంశం");}
raise                       {printf("లేపు");}
union                       {printf("సంఘం");}
while                       {printf("అయితే");}
write                       {printf("లిఖ");}
NULL                        {printf("ఖాళీ");}
case                        {printf("స్థితి");}
char                        {printf("అక్షరం");}
else                        {printf("లేకపోతే");}
enum                        {printf("గణన");}
free                        {printf("విడుదల");}
goto                        {printf("వెళ్ళు");}
main                        {printf("ప్రధాన");}
read                        {printf("పఠ");}
type                        {printf("రకం");}
void                        {printf("శూన్య");}
\#if                        {printf("#ఒకవేళ");}
for                         {printf("కొరకు");}
int                         {printf("పూర్ణాంకం");}
do                          {printf("చేయి");}
if                          {printf("ఒకవేళ");}
[A-Za-z_][A-Za-z0-9_]*      {printf("%s",yytext);}
%%
