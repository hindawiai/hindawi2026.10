%%
\'("\\\'"|.*)*\'                       {printf("%s",yytext);}
\"("\\\""|[^\"^\n]*)*\"                {printf("%s",yytext);}

forward                     {printf("అగ్రప్రసార");}
end                         {printf("ముగింపు");}
if                          {printf("ఒకవేళ");}
[A-Za-z_][A-Za-z0-9_]*      {printf("%s",yytext);}
%%
