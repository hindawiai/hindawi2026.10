%{
/* telugu h2b.uhin: generated from the telugu lexicon by lang/hindawi/tools/complete_cells.py,
   in the form of Chintamani's own transducers. Constructs without a word are in STATUS.tsv. */
%}
%%
\'("\\\'"|.*)*\'                       {printf("%s",yytext);}
\"("\\\""|[^\"^\n]*)*\"                {printf("%s",yytext);}

కాలయన్త్ర                   {printf("TIMER");}
పూర్ణాంకం                   {printf("INT");}
స్థిరరాశి                   {printf("CONST");}
ముగింపు                     {printf("END");}
లేకపోతే                     {printf("ELSE");}
సహభాజిత                     {printf("SHARED");}
తిరిగి                      {printf("RETURN");}
పదబంధం                      {printf("STRING");}
పిలువు                      {printf("CALL");}
వెళ్ళు                      {printf("GOTO");}
అనుకో                       {printf("LET");}
అయితే                       {printf("WHILE");}
ఒకవేళ                       {printf("IF");}
కొరకు                       {printf("FOR");}
మరియు                       {printf("AND");}
స్థిర                       {printf("STATIC");}
కాదు                        {printf("NOT");}
చేయి                        {printf("DO");}
లేదా                        {printf("OR");}
ఇవ                          {printf("AS");}

%%
