%{
/* russian h2asm.uhin: generated from the russian lexicon by lang/hindawi/tools/complete_cells.py,
   in the form of Chintamani's own transducers. Constructs without a word are in STATUS.tsv. */
%}
%%
\'("\\\'"|.*)*\'                       {printf("%s",yytext);}
\"("\\\""|[^\"^\n]*)*\"                {printf("%s",yytext);}

иначе                       {printf("ELSE");}
целое                       {printf("INT");}
если                        {printf("IF");}
пока                        {printf("WHILE");}

%%
