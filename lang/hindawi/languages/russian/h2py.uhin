%%
\'("\\\'"|.*)*\'                       {printf("%s",yytext);}
\"("\\\""|[^\"^\n]*)*\"                {printf("%s",yytext);}

основной                    {printf("main");}
вернуть                     {printf("return");}
иначе                       {printf("else");}
целое                       {printf("int");}
если                        {printf("if");}
пока                        {printf("while");}
для                         {printf("for");}

%%
