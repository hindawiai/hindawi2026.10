%{
/* sundanese asm2h.uhin: generated from the sundanese lexicon by lang/hindawi/tools/complete_cells.py,
   in the form of Chintamani's own transducers. Constructs without a word are in STATUS.tsv. */
%}
%%
\'("\\\'"|.*)*\'                       {printf("%s",yytext);}
\"("\\\""|[^\"^\n]*)*\"                {printf("%s",yytext);}

WHILE                       {printf("ᮞᮨᮓᮨᮜ");}
ELSE                        {printf("ᮜᮤᮚ");}
AND                         {printf("ca");}
INT                         {printf("puur_naa_nka");}
NOT                         {printf("na");}
IF                          {printf("ᮚᮦᮔ᮪");}
IN                          {printf("anta_h");}
[A-Za-z_][A-Za-z0-9_]*      {printf("%s",yytext);}
%%
