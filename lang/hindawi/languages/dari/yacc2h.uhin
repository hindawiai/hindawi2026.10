switch                      {printf("بدل");}
\#elif                      {printf("#وإلاإذا");}
\#else                      {printf("#وإلا");}
break                       {printf("اكسر");}
const                       {printf("ثابت");}
float                       {printf("عائم");}
raise                       {printf("ارفع");}
right                       {printf("راست");}
