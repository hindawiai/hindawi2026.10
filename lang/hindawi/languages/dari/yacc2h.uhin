\#if                        {printf("#إذا");}
for                         {printf("لكل");}
int                         {printf("صحيح");}
do                          {printf("افعل");}
if                          {printf("إذا");}
[A-Za-z_][A-Za-z0-9_]*      {printf("%s",yytext);}
