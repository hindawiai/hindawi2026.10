%{
/* aramaic b2h.uhin: generated from the aramaic lexicon by lang/hindawi/tools/complete_cells.py,
   in the form of Chintamani's own transducers. Constructs without a word are in STATUS.tsv. */
%}
%%
\'("\\\'"|.*)*\'                       {printf("%s",yytext);}
\"("\\\""|[^\"^\n]*)*\"                {printf("%s",yytext);}

RETURN                      {printf("أرجع");}
SHARED                      {printf("مشترك");}
STATIC                      {printf("ساكن");}
STRING                      {printf("نص");}
return                      {printf("أرجع");}
CONST                       {printf("ثابت");}
TIMER                       {printf("مؤقت");}
WHILE                       {printf("طالما");}
while                       {printf("طالما");}
CALL                        {printf("نادي");}
ELSE                        {printf("وإلا");}
GOTO                        {printf("اذهب");}
goto                        {printf("اذهب");}
AND                         {printf("𐡅");}
END                         {printf("𐡎𐡅𐡐");}
FOR                         {printf("لكل");}
INT                         {printf("صحيح");}
LET                         {printf("ليكن");}
NOT                         {printf("𐡋𐡀");}
end                         {printf("𐡎𐡅𐡐");}
for                         {printf("لكل");}
let                         {printf("ليكن");}
AS                          {printf("كـ");}
DO                          {printf("𐡏𐡁𐡃");}
IF                          {printf("𐡄𐡍");}
OR                          {printf("𐡀𐡅");}
if                          {printf("𐡄𐡍");}
[A-Za-z_][A-Za-z0-9_]*      {printf("%s",yytext);}
%%
