மற்றும்                     {printf("AND");}
ஸஹ஭ாஜித                     {printf("SHARED");}
அல்லது                      {printf("OR");}
மாறிலி                      {printf("CONST");}
இல்லை                       {printf("NOT");}
எனில்                       {printf("IF");}
கொள்                        {printf("LET");}
க்கு                        {printf("FOR");}
சரம்                        {printf("STRING");}
செய்                        {printf("DO");}
செல்                        {printf("GOTO");}
போது                        {printf("WHILE");}
முடி                        {printf("END");}
முழு                        {printf("INT");}
