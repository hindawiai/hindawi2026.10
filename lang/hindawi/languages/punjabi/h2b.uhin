%{
/* punjabi h2b.uhin: generated from the punjabi lexicon by lang/hindawi/tools/complete_cells.py,
   in the form of Chintamani's own transducers. Constructs without a word are in STATUS.tsv. */
%}
%%
\'("\\\'"|.*)*\'                       {printf("%s",yytext);}
\"("\\\""|[^\"^\n]*)*\"                {printf("%s",yytext);}

ਕਾਲਯਨ੍ਤ੍ਰ                   {printf("TIMER");}
ਸ਼ਬਦਮਾਲਾ                    {printf("STRING");}
ਨਹੀਂਤਾਂ                     {printf("ELSE");}
ਸਹਭਾਜਿਤ                     {printf("SHARED");}
ਬੁਲਾਓ                       {printf("CALL");}
ਜਦੋਂ                        {printf("WHILE");}
ਨਹੀਂ                        {printf("NOT");}
ਪੂਰਨ                        {printf("INT");}
ਮੰਨੋ                        {printf("LET");}
ਵਾਪਸ                        {printf("RETURN");}
ਸਥਿਰ                        {printf("STATIC");}
ਅਚਲ                         {printf("CONST");}
ਅਤੇ                         {printf("AND");}
ਅੰਤ                         {printf("END");}
ਕਰੋ                         {printf("DO");}
ਜਾਂ                         {printf("OR");}
ਜਾਓ                         {printf("GOTO");}
ਇਵ                          {printf("AS");}
ਜੇ                          {printf("IF");}
ਲਈ                          {printf("FOR");}

%%
