\'("\\\'"|.*)*\'                       {printf("%s",yytext);}
\"("\\\""|[^\"^\n]*)*\"                {printf("%s",yytext);}

ಅಧ್ಯವಸ್ಯತಿ                  {printf("ASSUME");}
ಅನ್ತರ್ಭಾವ                   {printf("INCLUDE");}
ಪೂರ್ಣಾಙ್ಕ                   {printf("INT");}
ಸಾರ್ವಜನಿಕ                   {printf("PUBLIC");}
ನಿರ್ದೇಶಕ                    {printf("PTR");}
ವೈಶ್ವಿಕ                     {printf("global");}
ಅನ್ಯಥಾ                      {printf("ELSE");}
ಆಹ್ವಾನ                      {printf("CALL");}
ಪ್ರಕಾರ                      {printf("TYPE");}
ಅನ್ತಃ                       {printf("IN");}
ಬಾಹ್ಯ                       {printf("EXTERN");}
ಯಾವತ್                       {printf("WHILE");}
ಅನ್ತ                        {printf("END");}
ಏತತ್                        {printf("THIS");}
ತಾಲಕ                        {printf("LOCK");}
ವಿಧಿ                        {printf("PROC");}
ಯದಿ                         {printf("IF");}
ವಾ                          {printf("OR");}
ಚ                           {printf("AND");}
ನ                           {printf("NOT");}

