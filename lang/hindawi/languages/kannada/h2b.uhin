%%
\'("\\\'"|.*)*\'                       {printf("%s",yytext);}
\"("\\\""|[^\"^\n]*)*\"                {printf("%s",yytext);}

ಇಲ್ಲದಿದ್ದರೆ                 {printf("ELSE");}
ಕಾಲಯನ್ತ್ರ                   {printf("TIMER");}
ಹಿಂತಿರುಗಿ                   {printf("RETURN");}
ಪೂರ್ಣಾಂಕ                    {printf("INT");}
ಸ್ಥಿರಾಂಕ                    {printf("CONST");}
ಸಹಭಾಜಿತ                     {printf("SHARED");}
ಪದಪುಂಜ                      {printf("STRING");}
ಅಂತ್ಯ                       {printf("END");}
ಮತ್ತು                       {printf("AND");}
ಸ್ಥಿರ                       {printf("STATIC");}
ಅಥವಾ                        {printf("OR");}
ಅಲ್ಲ                        {printf("NOT");}
ಆದರೆ                        {printf("IF");}
ಇರಲಿ                        {printf("LET");}
ಗಾಗಿ                        {printf("FOR");}
ಮಾಡು                        {printf("DO");}
ಹೋಗು                        {printf("GOTO");}
ಕರೆ                         {printf("CALL");}
ಆಗ                          {printf("WHILE");}
ಇವ                          {printf("AS");}

