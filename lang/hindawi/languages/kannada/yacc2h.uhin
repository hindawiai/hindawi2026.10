%%
\'("\\\'"|.*)*\'                       {printf("%s",yytext);}
\"("\\\""|[^\"^\n]*)*\"                {printf("%s",yytext);}

protected                   {printf("ಸಂರಕ್ಷಿತ");}
\#include                   {printf("#ಅನ್ತರ್ಭಾವ");}
continue                    {printf("ಮುಂದುವರಿ");}
register                    {printf("ನೋಂದಣಿ");}
volatile                    {printf("ಅಸ್ಥಿರ");}
default                     {printf("ಪೂರ್ವನಿಯೋಜಿತ");}
private                     {printf("ಖಾಸಗಿ");}
typedef                     {printf("ಪ್ರಕಾರವ್ಯಾಖ್ಯೆ");}
virtual                     {printf("ವಾಸ್ತವಿಕ");}
assert                      {printf("ಪ್ರತಿಜ್ಞಾ");}
double                      {printf("ದ್ವಿಗುಣ");}
extern                      {printf("ಬಾಹ್ಯ");}
inline                      {printf("ಸಾಲೊಳಗೆ");}
public                      {printf("ಸಾರ್ವಜನಿಕ");}
return                      {printf("ಹಿಂತಿರುಗಿ");}
signal                      {printf("ಸಂಕೇತ");}
sizeof                      {printf("ಗಾತ್ರ");}
static                      {printf("ಸ್ಥಿರ");}
struct                      {printf("ರಚನೆ");}
switch                      {printf("ಆಯ್ಕೆ");}
\#elif                      {printf("#ಅಥವಾಆದರೆ");}
\#else                      {printf("#ಇಲ್ಲದಿದ್ದರೆ");}
break                       {printf("ನಿಲ್ಲಿಸು");}
const                       {printf("ಸ್ಥಿರಾಂಕ");}
float                       {printf("ದಶಮಾಂಶ");}
raise                       {printf("ಎತ್ತು");}
union                       {printf("ಒಕ್ಕೂಟ");}
while                       {printf("ಆಗ");}
write                       {printf("ಲಿಖ");}
NULL                        {printf("ಖಾಲಿ");}
case                        {printf("ಸ್ಥಿತಿ");}
char                        {printf("ಅಕ್ಷರ");}
else                        {printf("ಇಲ್ಲದಿದ್ದರೆ");}
enum                        {printf("ಎಣಿಕೆ");}
free                        {printf("ಬಿಡುಗಡೆ");}
goto                        {printf("ಹೋಗು");}
main                        {printf("ಮುಖ್ಯ");}
read                        {printf("ಪಠ");}
type                        {printf("ಪ್ರಕಾರ");}
void                        {printf("ಶೂನ್ಯ");}
\#if                        {printf("#ಆದರೆ");}
for                         {printf("ಗಾಗಿ");}
int                         {printf("ಪೂರ್ಣಾಂಕ");}
do                          {printf("ಮಾಡು");}
if                          {printf("ಆದರೆ");}
[A-Za-z_][A-Za-z0-9_]*      {printf("%s",yytext);}
%%
