%%
\'("\\\'"|.*)*\'                       {printf("%s",yytext);}
\"("\\\""|[^\"^\n]*)*\"                {printf("%s",yytext);}

forward                     {printf("ಅಗ್ರಪ್ರಸಾರ");}
end                         {printf("ಅಂತ್ಯ");}
if                          {printf("ಆದರೆ");}
[A-Za-z_][A-Za-z0-9_]*      {printf("%s",yytext);}
%%
