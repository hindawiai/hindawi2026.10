\'("\\\'"|.*)*\'                       {printf("%s",yytext);}
\"("\\\""|[^\"^\n]*)*\"                {printf("%s",yytext);}

아니면                         {printf("ELSE");}
동안                          {printf("WHILE");}
만약                          {printf("IF");}
정수                          {printf("INT");}

