%%
\'(\\.|[^\\\'\n])*\'                       {printf("%s",yytext);}
\"(\\.|[^\\\"\n])*\"                       {printf("%s",yytext);}

\#아니면                       {printf("#else");}
\#만약                        {printf("#if");}
아니면                         {printf("else");}
동안                          {printf("while");}
만약                          {printf("if");}
반환                          {printf("return");}
위해                          {printf("for");}
정수                          {printf("int");}

%%
