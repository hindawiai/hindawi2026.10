#!/bin/bash
# hindawicc — drop-in gcc replacement
# Pipeline: native script → transliterate → Devanagari → h2c.uhin → C → gcc

set -e
FLEX_PATH="${FLEX_PATH:-/tmp/flexroot/usr/bin}"
ROMENAGRI="${ROMENAGRI:-/tmp/chintamani/Romenagri}"
export PATH="$FLEX_PATH:$PATH"
export LD_LIBRARY_PATH="/tmp/flexroot/usr/lib/x86_64-linux-gnu:${LD_LIBRARY_PATH:-}"

SCRIPT_DIR="$(dirname "$0")"
CHINT="$SCRIPT_DIR/upstream/chintamani"
TRANS="$SCRIPT_DIR/pipeline/transliterate.py"
H2C="$CHINT/guru/h2c"

# ensure scanner exists
if [ ! -x "$H2C" ]; then
    if [ -f "$CHINT/guru/h2c.uhin" ]; then
        flex -o /tmp/h2c_lex.c "$CHINT/guru/h2c.uhin" 2>/dev/null
        gcc -o "$H2C" /tmp/h2c_lex.c -L/tmp/flexroot/usr/lib/x86_64-linux-gnu -lfl 2>/dev/null || true
    fi
fi

GCC_ARGS=()
SOURCES=()
OUT_NAME="a.out"

while [ $# -gt 0 ]; do
    case "$1" in
        -o) OUT_NAME="$2"; shift 2 ;;
        -o*) OUT_NAME="${1#-o}"; shift ;;
        *.uhin|*.hin)
            SOURCES+=("$1"); shift ;;
        *)
            GCC_ARGS+=("$1"); shift ;;
    esac
done

C_FILES=()
for src in "${SOURCES[@]}"; do
    base="${src%.*}"
    deva_out="${base}_deva.uhin"
    c_out="${base}.c"
    # transliterate to Devanagari
    if [ -f "$TRANS" ]; then
        python3 "$TRANS" < "$src" > "$deva_out" 2>/dev/null || cp "$src" "$deva_out"
    else
        cp "$src" "$deva_out"
    fi
    # run through Hindi h2c
    if [ -x "$H2C" ]; then
        "$H2C" < "$deva_out" > "$c_out" 2>/dev/null || cp "$deva_out" "$c_out"
    else
        cp "$deva_out" "$c_out"
    fi
    C_FILES+=("$c_out")
done

# compile
if [ ${#C_FILES[@]} -gt 0 ]; then
    gcc "${GCC_ARGS[@]}" -o "$OUT_NAME" "${C_FILES[@]}" 2>/dev/null || gcc "${GCC_ARGS[@]}" -o "$OUT_NAME" "${SOURCES[@]}"
else
    gcc "${GCC_ARGS[@]}" -o "$OUT_NAME"
fi
