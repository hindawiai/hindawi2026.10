#!/usr/bin/env bash
# hindawicc: a drop-in gcc for Hindawi. Each native source (.uhin, .hin, and .c/.h when HINDAWI_NATIVE_SOURCE=1)
# goes through the compilation path of tools/hindawi_chain.py: script filter, Romenagri, the language's h2c, the
# original driver's repairs. -D and -U names go through the build's dictionary to their C-level form, so a
# Makefile's definitions meet the names the sources now carry. Every other argument goes to gcc untouched.
# Nothing falls back: a source that does not transduce stops the build.
# © 1993–2026 Abhishek Choudhary. All rights reserved. AyeAI.
#   ROMENAGRI             a built Romenagri folder (required)
#   HINDAWI_LANG          the language (default hindi)
#   HINDAWI_DICT          the ingestion's dictionary, for -D and -U names
#   HINDAWI_NATIVE_SOURCE 1 when .c and .h files hold native code
#   HINDAWI_KEEP=1        keeps each generated C file beside its source
set -euo pipefail
SRC="$0"; while [ -L "$SRC" ]; do D="$(cd "$(dirname "$SRC")" && pwd)"; SRC="$(readlink "$SRC")"; case "$SRC" in /*) ;; *) SRC="$D/$SRC" ;; esac; done
HERE="$(cd "$(dirname "$SRC")" && pwd)"; CHAIN="$HERE/tools/hindawi_chain.py"
: "${ROMENAGRI:?set ROMENAGRI to a built Romenagri folder}"
L="${HINDAWI_LANG:-hindi}"; DICT="${HINDAWI_DICT:-}"; NATIVE_C="${HINDAWI_NATIVE_SOURCE:-0}"
work="$(mktemp -d)"; trap 'rm -rf "$work"' EXIT
macro() {   # -DNAME[=value] or -UNAME: NAME to its C-level form through the dictionary
  [ -n "$DICT" ] && [ -f "$DICT" ] || { printf '%s' "$1"; return; }
  python3 - "$DICT" "$L" "$1" "$CHAIN" <<'PY'
import json, re, sys
dpath, lang, arg, chain = sys.argv[1:]
sys.path.insert(0, chain.rsplit("/", 1)[0]); import hindawi_chain as c
m = re.match(r"^(-[DU])([^=\s]+)(=.*)?$", arg)
if not m: print(arg, end=""); raise SystemExit
pre, name, tail = m.groups()
native = json.load(open(dpath, encoding="utf-8")).get("forward", {}).get(name, name)
print(pre + c.c_names([native], lang)[native] + (tail or ""), end="")
PY
}
args=(); n=0; pending=""
for a in "$@"; do
  if [ -n "$pending" ]; then args+=("$(macro "$pending$a" | cut -c3-)"); pending=""; continue; fi
  case "$a" in
    -D|-U) args+=("$a"); pending="$a" ;;
    -D*|-U*) args+=("$(macro "$a")") ;;
    *.uhin|*.hin|*.c|*.h|*.cc|*.cpp|*.cxx)
      if [[ "$a" == *.uhin || "$a" == *.hin || "$NATIVE_C" == 1 ]] && [ -f "$a" ]; then
        n=$((n+1)); base="$(basename "$a")"; c="$work/$n-${base%.*}.c"
        python3 "$CHAIN" to-c --lang "$L" < "$a" > "$c" || { echo "hindawicc: $a did not transduce" >&2; exit 1; }
        [ "${HINDAWI_KEEP:-0}" = 1 ] && cp "$c" "${a%.*}.c"
        args+=("$c")
      else args+=("$a"); fi ;;
    *) args+=("$a") ;;
  esac
done
exec gcc "${args[@]}"
