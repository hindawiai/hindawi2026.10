#!/usr/bin/env bash
# hindawicc: a gcc front end for Hindawi sources. Every .uhin goes through the original chain, exactly as
# Chintamani's hincc and gurucc run it: fixuninum | iconv | uni2acii | acii2cf | acii2uni | iconv | <cell>/h2c,
# then the driver's own escape repairs. Everything else on the command line goes to gcc untouched (-O, -D, -I,
# -L, -l, -c, -g, -o ...). Nothing falls back: if a source does not transduce, hindawicc stops and says so.
# © 1993–2026 Abhishek Choudhary. All rights reserved. AyeAI.
#   ROMENAGRI   a built Romenagri folder (required)
#   HINDAWI_CELL the folder holding the language's built h2c (default: Chintamani's own guru, Hindi)
#   HINDAWI_KEEP=1 keeps the generated .c beside each source
set -euo pipefail
ROMENAGRI="${ROMENAGRI:?set ROMENAGRI to a built Romenagri folder}"
CELL="${HINDAWI_CELL:-$(cd "$(dirname "$0")" && pwd)/upstream/chintamani/guru}"
[ -x "$CELL/h2c" ] || { echo "hindawicc: no built h2c in $CELL (run make there, with Romenagri on the PATH)" >&2; exit 2; }
export PATH="$ROMENAGRI:$PATH"
work="$(mktemp -d)"; trap 'rm -rf "$work"' EXIT
args=(); n=0
for a in "$@"; do
  case "$a" in
    *.uhin|*.hin)
      [ -f "$a" ] || { echo "hindawicc: no such source $a" >&2; exit 2; }
      n=$((n+1)); c="$work/$n-$(basename "${a%.*}").c"
      fixuninum < "$a" | iconv -f utf-8 -t utf-16 | uni2acii | acii2cf | acii2uni | iconv -f UTF-16 -t UTF-8 \
        | "$CELL/h2c" > "$c" || { echo "hindawicc: $a did not transduce" >&2; exit 1; }
      sed -i 's/\\न/\\n/g; s/\%भ/\%f/g; s/\%प/\%d/g;' "$c"
      [ "${HINDAWI_KEEP:-0}" = 1 ] && cp "$c" "${a%.*}.c"
      args+=("$c") ;;
    *) args+=("$a") ;;
  esac
done
exec gcc "${args[@]}"
