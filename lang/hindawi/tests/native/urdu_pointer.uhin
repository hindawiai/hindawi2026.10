#include <stdio.h>

صحیح جمع(صحیح *آ, صحیح ن)
{
    صحیح کل = 0;
    صحیح *پ = آ;
    جبتک (ن > 0)
    {
        کل = کل + *پ;
        پ = پ + 1;
        ن = ن - 1;
    }
    واپس کل;
}

صحیح مین()
{
    صحیح اعداد[4] = {10, 20, 30, 40};
    صحیح نتیجہ = جمع(اعداد, 4);
    printf("%d\n", نتیجہ);
    واپس 0;
}
