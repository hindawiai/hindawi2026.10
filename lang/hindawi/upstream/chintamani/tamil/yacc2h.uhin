c                    {printf("native");}
if                   {printf("எனில்");}
else                 {printf("இல்லையெனில்");}
while                {printf("வரை");}
do                   {printf("செய்");}
for                  {printf("க்கு");}
break                {printf("நிறுத்து");}
continue             {printf("தொடர்");}
switch               {printf("தேர்வு");}
case                 {printf("நிலை");}
default              {printf("இயல்பு");}
return               {printf("திரும்பு");}
const                {printf("மாறிலி");}
int                  {printf("முழு");}
float                {printf("தசம");}
double               {printf("இரட்டை");}
char                 {printf("எழுத்து");}
void                 {printf("வெறுமை");}
void                 {printf("செயல்");}
class                {printf("வகுப்பு");}
new                  {printf("புதிய");}
public               {printf("பொது");}
private              {printf("தனிப்பட்ட");}
static               {printf("நிலையான");}
virtual              {printf("மெய்நிகர்");}
case                 {printf("போது");}
struct               {printf("கட்டமைப்பு");}
.  {printf("%s", yytext);}
