<शैली श्रेणी>
#समावेश <मानकपन.स>

श्रेणी आकृति {
खुला:
    भव व्योम क्षेत्र() { म_लिखो("आकृति\n"); }
};

श्रेणी वृत्त : खुला आकृति {
खुला:
    द्विगुन त्रिज्या;
    वृत्त(द्विगुन त) { त्रिज्या = त; }
    व्योम क्षेत्र() { म_लिखो("वृत्त क्षेत्र = %.2f\n", 3.14159 * त्रिज्या * त्रिज्या); }
};

श्रेणी आयत : खुला आकृति {
खुला:
    द्विगुन लंबाई, चौड़ाई;
    आयत(द्विगुन ल, द्विगुन च) { लंबाई = ल; चौड़ाई = च; }
    व्योम क्षेत्र() { म_लिखो("आयत क्षेत्र = %.2f\n", लंबाई * चौड़ाई); }
};

पूर्णांक मुख्य()
{
    आकृति *अ[] = { नवीन वृत्त(5.0), नवीन आयत(4.0, 6.0) };
    पूर्णांक इ;
    क्रम(इ = 0; इ < 2; इ++) अ[इ]->क्षेत्र();
    वापस 0;
}
