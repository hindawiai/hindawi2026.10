<शैली गुरु>
#समावेश <मानकपन.स>

पूर्णांक मुख्य()
{
    पूर्णांक अ[] = {64, 34, 25, 12, 22, 11, 90}, न = 7, इ, ज, त;
    क्रम(इ = 0; इ < न - 1; इ++)
        क्रम(ज = 0; ज < न - इ - 1; ज++)
            अगर (अ[ज] > अ[ज + 1]) {
                त = अ[ज]; अ[ज] = अ[ज + 1]; अ[ज + 1] = त;
            }
    म_लिखो("बुलबुला क्रम: ");
    क्रम(इ = 0; इ < न; इ++) म_लिखो("%d ", अ[इ]);
    म_लिखो("\n");
    वापस 0;
}
