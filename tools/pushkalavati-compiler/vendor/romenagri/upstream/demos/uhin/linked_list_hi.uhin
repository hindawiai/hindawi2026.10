<शैली गुरु>
#समावेश <मानकपन.स>
#समावेश <आवंटन.स>

संरचना गाँठ {
    पूर्णांक मान;
    संरचना गाँठ *आगे;
};

व्योम जोड़ो(संरचना गाँठ **मूल, पूर्णांक म)
{
    संरचना गाँठ *नया = (संरचना गाँठ*)आवंटित(sizeof(संरचना गाँठ));
    नया->मान = म;
    नया->आगे = *मूल;
    *मूल = नया;
}

पूर्णांक मुख्य()
{
    संरचना गाँठ *सूची = शून्य;
    पूर्णांक इ;
    क्रम(इ = 1; इ <= 5; इ++) जोड़ो(&सूची, इ * 10);
    म_लिखो("कड़ी सूची: ");
    जबतक (सूची) {
        म_लिखो("%d ", सूची->मान);
        सूची = सूची->आगे;
    }
    म_लिखो("\n");
    वापस 0;
}
