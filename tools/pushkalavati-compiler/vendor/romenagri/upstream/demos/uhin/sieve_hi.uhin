<शैली गुरु>
#समावेश <मानकपन.स>

पूर्णांक मुख्य()
{
    पूर्णांक न = 50, इ, ज, अ[51];
    क्रम(इ = 2; इ <= न; इ++) अ[इ] = 1;
    क्रम(इ = 2; इ * इ <= न; इ++)
        अगर (अ[इ])
            क्रम(ज = इ * इ; ज <= न; ज += इ) अ[ज] = 0;
    म_लिखो("अभाज्य संख्याएँ: ");
    क्रम(इ = 2; इ <= न; इ++)
        अगर (अ[इ]) म_लिखो("%d ", इ);
    म_लिखो("\n");
    वापस 0;
}
